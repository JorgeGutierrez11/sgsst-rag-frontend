# Backend API origin (optional base path allowed, no trailing slash needed).
# Read by the Next.js server on every request: change it and restart, no rebuild required.
# Inside Docker, 127.0.0.1 is the container itself: use http://host.docker.internal:8000
# for a backend on the host, or the backend service name on a shared network.
SGSST_API_URL=http://127.0.0.1:8000

# Docker Compose only (optional)
# FRONTEND_PORT=3000
# SGSST_BACKEND_NETWORK=sg-sst_default
