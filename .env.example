# Backend API origin read by the Next.js server (proxy.ts) on every request.
# Change it and restart: no rebuild required. Copy this file and keep ONE value:
#
#   pnpm dev, backend on this machine        -> .env.local  SGSST_API_URL=http://127.0.0.1:8000
#   Docker + compose.backend-network.yaml    -> .env        SGSST_API_URL=http://backend:8000
#   Docker, backend running outside Docker   -> .env        SGSST_API_URL=http://host.docker.internal:8000
#
# Inside a container, 127.0.0.1 and localhost are the container itself, never the backend.
SGSST_API_URL=http://127.0.0.1:8000

# Docker Compose only (optional)
# FRONTEND_PORT=3000
# SGSST_BACKEND_NETWORK=sg-sst_default
